# =============================================================================
# Krishi-Mitra — Single Repo-Wide .gitignore (Root)
# =============================================================================

# --- Environment & secrets ---
.env
.env.*
!.env.example
backend/.env

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- IDE & OS ---
.vscode/
.idea/
*.swp
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
.DS_Store
Thumbs.db
ehthumbs.db

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- JavaScript / Node / React / Vite / Expo ---
node_modules/
dist/
dist-ssr/
build/
web-build/
.next/
out/
.expo/
*.local
expo-env.d.ts

# --- ML weights & exports (large binaries) ---
weights/
*.pt
*.pth

# Ignore ONNX and model weights directory (large binaries >100MB)
*.onnx
backend/agent/model/
backend/agent/models/


# --- Datasets ---
plantvillage/
plantvillage_subset/

# --- YOLO / training outputs ---
runs/

# --- Uploads & notebook checkpoints ---
uploads/
.ipynb_checkpoints/
scripts/.ipynb_checkpoints/

# --- Local tooling ---
ngrok.exe

# --- Scratch / test images ---
*.jpg
*.png
*.jpeg
